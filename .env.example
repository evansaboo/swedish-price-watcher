# Port the web UI listens on
PORT=3000

# Bind to all interfaces (required for Docker / reverse proxy)
HOST=0.0.0.0

DATA_FILE=data/store.json
SOURCES_FILE=config/sources.json

# Run a scan immediately on startup
RUN_ON_START=true

# Default interval between full scans (minutes); overridable per-source
SCAN_INTERVAL_MINUTES=180

HOST_DELAY_MS=8000
REQUEST_TIMEOUT_MS=20000
MAX_HISTORY_ENTRIES=20
USER_AGENT=swedish-price-watcher/0.1 (+you@example.com)

# --- Scraping services (optional) ---
APIFY_TOKEN=
APIFY_TOKEN_2=
APIFY_TOKEN_3=
APIFY_STATE_STORE_NAME=swedish-price-watcher-state
APIFY_STATE_RECORD_KEY=state
SCRAPFLY_API_KEY=

# FlareSolverr URL — set automatically by docker-compose; override here for local dev
# FLARESOLVERR_URL=http://localhost:8191

# --- Cloudflare Tunnel (for public access via your domain) ---
# Create tunnel: cloudflared tunnel create price-watcher
# Then add DNS route: cloudflared tunnel route dns price-watcher price-watcher.evansaboo.com
CLOUDFLARE_TUNNEL_TOKEN=

# --- Notifications ---
DISCORD_WEBHOOK_URL=
NOTIFICATION_COOLDOWN_HOURS=24
DISABLE_HOURS_ON_BLOCK=12

# --- Affiliate links ---
# Approved tracking template for a source. It MUST contain {url}.
AFFILIATE_LINK_TEMPLATE_KOMPLETT_OUTLET_ELECTRONICS=

# --- Deal filters ---
MINIMUM_SCORE=65
MINIMUM_DISCOUNT_PERCENT=10
MINIMUM_PROFIT_SEK=50

# --- Assisted checkout (Elgiganten) ---
# Payment is NEVER automated. Staging stops at the checkout page; you always
# confirm the card step yourself (BankID / 3-D Secure).
#
# Required for every buy control (dashboard + Discord). Without it all
# /api/purchase routes return 501.
ADMIN_API_TOKEN=
#
# Discord buttons. Plain channel webhooks CANNOT render buttons, so a real
# Discord application + bot is required:
#   1. https://discord.com/developers/applications -> New Application
#   2. Copy "Public Key" -> DISCORD_PUBLIC_KEY
#   3. Set Interactions Endpoint URL -> https://<your-host>/api/discord/interactions
#   4. Bot tab -> reset/copy token -> DISCORD_BOT_TOKEN, invite the bot to your server
#   5. Right-click your alert channel -> Copy Channel ID -> DISCORD_ALERT_CHANNEL_ID
#   6. Your own user ID (Settings -> Advanced -> Developer Mode -> right-click yourself)
# DISCORD_OWNER_IDS is an allow-list: if it is empty, EVERY button click is refused.
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_OWNER_IDS=
#
# Optional. Without credentials the bot stages an anonymous cart and the login
# happens in your browser instead.
ELGIGANTEN_EMAIL=
ELGIGANTEN_PASSWORD=
ELGIGANTEN_SESSION_PATH=./data/elgiganten-session.json

# Elgiganten fronts its site with a Vercel firewall. If it starts answering
# every path with 403 "x-vercel-mitigated: deny", your egress IP has been
# blocked outright — no browser or fingerprint tweak recovers from that. All
# Elgiganten sources then stand down for a cooldown instead of relaunching
# Chromium every cycle. Point this at an HTTP(S) proxy on a different IP
# (residential proxies work best) to restore access sooner.
# Accepts http(s):// or socks5://. A credentialed socks5:// URL is fronted
# automatically by a local HTTP bridge, since Chromium cannot authenticate to
# SOCKS. For NordVPN use your *service* credentials (Nord dashboard ->
# "Set up NordVPN manually"), not your account login:
#   socks5://<service-user>:<service-pass>@se.socks.nordhold.net:1080
ELGIGANTEN_PROXY_URL=
# Where the reusable browser storage state is kept.
ELGIGANTEN_BROWSER_STATE_PATH=./data/elgiganten-browser-state.json
# How long to stand the Elgiganten sources down after a deny (default 6).
ELGIGANTEN_BLOCK_COOLDOWN_HOURS=
